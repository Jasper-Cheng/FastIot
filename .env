# ============================================
# FastIot 后端环境配置文件
# 说明：不要提交到 Git，敏感信息请保密
# ============================================

# ----------------------
# 数据库 MySQL 配置
# ----------------------
# 数据库 URL，格式: mysql+aiomysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+aiomysql://fastiot:password@mysql:3306/fastiot_db
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=fastiot_db
MYSQL_USER=fastiot
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=rootpassword

# ----------------------
# Redis 配置
# ----------------------
# 用于缓存和 Celery 结果存储
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ----------------------
# RabbitMQ 配置
# ----------------------
# AMQP URL，格式: amqp://用户名:密码@主机:端口/虚拟主机
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672//
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# ----------------------
# 安全配置
# ----------------------
# 用于 JWT 或密码加密
SECRET_KEY=your_super_secret_key
# JWT token 过期时间，单位分钟（这里1天）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------------
# FastAPI 配置
# ----------------------
# 是否开启调试模式
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ----------------------
# Celery 配置
# ----------------------
# Celery 使用 Redis 或 RabbitMQ 作为 Broker
CELERY_BROKER_URL="${RABBITMQ_URL}"  # 任务队列地址
CELERY_RESULT_BACKEND="${REDIS_URL}" # 任务结果存储地址

# ----------------------
# 其他配置
# ----------------------
# 日志级别，可选 DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO
