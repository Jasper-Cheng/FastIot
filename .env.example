# ============================================
# FastIoT 环境变量配置文件模板
# 复制为 .env 并填写实际值
# ============================================

# ============================================
# 数据库配置 (MySQL)
# ============================================
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_DB=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_secure_password
MYSQL_ROOT_PASSWORD=your_root_password
DATABASE_URL=mysql+aiomysql://your_database_user:your_secure_password@your_mysql_host:3306/your_database_name

# ============================================
# Redis 缓存配置
# ============================================
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://your_redis_host:6379/0

# ============================================
# RabbitMQ 消息队列配置
# ============================================
RABBITMQ_HOST=your_rabbitmq_host
RABBITMQ_PORT=5672
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@your_rabbitmq_host:5672//

# ============================================
# 安全配置
# ============================================
SECRET_KEY=your_super_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# 应用配置
# ============================================
HOST=localhost
PORT=8000

# ============================================
# Celery 配置
# ============================================
CELERY_BROKER_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@your_rabbitmq_host:5672//
CELERY_RESULT_BACKEND=redis://your_redis_host:6379/0

# ============================================
# 可选配置
# ============================================
TZ=Asia/Shanghai
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8080"]'
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
